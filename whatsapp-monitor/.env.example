# =============================================
# CONFIGURAÇÃO DO MONITOR WHATSAPP
# Copie este arquivo para .env e preencha
# =============================================

# --- POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_123

# --- REDIS ---
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_456

# --- EVOLUTION API ---
# URL pública onde a Evolution vai rodar (trocar pelo IP/domínio da VPS)
EVOLUTION_SERVER_URL=https://evolution.seudominio.com
# Chave de autenticação da API (gere em https://api-keygen.com - use UUID)
EVOLUTION_API_KEY=GERE_UUID_AQUI

# --- CHATWOOT ---
# Chave secreta do Rails (gere com: openssl rand -hex 64)
SECRET_KEY_BASE=GERE_COM_OPENSSL_RAND_HEX_64
# URL pública do Chatwoot
CHATWOOT_FRONTEND_URL=https://chat.seudominio.com
# Account ID (geralmente 1 para primeira conta criada)
CHATWOOT_ACCOUNT_ID=1
# Token do usuário admin do Chatwoot (pegar após criar conta)
CHATWOOT_TOKEN=TOKEN_CHATWOOT_AQUI
# URL interna do Chatwoot (Docker network)
CHATWOOT_URL=http://chatwoot-rails:3000

# --- EMAIL (OPCIONAL - configurar depois) ---
MAILER_SENDER_EMAIL=noreply@seudominio.com
SMTP_DOMAIN=seudominio.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
