# =================================================================
# CONFIGURACOES OBRIGATORIAS
# =================================================================

# Token do bot (pegue com o @BotFather no Telegram)
BOT_TOKEN=cole_seu_token_aqui

# Chat ID do dono do negocio (quem vai receber os leads)
# Para descobrir: abra @userinfobot no Telegram
DONO_CHAT_ID=cole_seu_chat_id_aqui

# Qual configuracao de nicho usar (arquivo dentro de configs/, sem .py)
# Modo FIXO (fluxo de perguntas): corretor, clinica_estetica, advogado, personal_trainer, dentista
# Modo IA (conversa com LLM):     corretor_ia
NICHO=corretor

# =================================================================
# APENAS PARA MODO IA (usar quando NICHO termina com _ia)
# =================================================================

# Chave da API do Groq (grátis) - pegue em https://console.groq.com
GROQ_API_KEY=cole_sua_chave_groq_aqui

# Qual perfil de cliente usar (arquivo dentro de clientes/, sem .py)
# Deixe em branco para usar o cliente_default definido no config
CLIENTE=direcional_israel
