# Token do bot (pegue com o @BotFather no Telegram)
BOT_TOKEN=cole_seu_token_aqui

# Chat ID do dono do negocio (quem vai receber os leads)
# Para descobrir: abra @userinfobot no Telegram e ele te mostra seu ID
DONO_CHAT_ID=cole_seu_chat_id_aqui

# Qual configuracao de nicho usar (nome do arquivo dentro de configs/, sem .py)
# Opcoes prontas: corretor, clinica_estetica, advogado, personal_trainer, dentista
NICHO=corretor
